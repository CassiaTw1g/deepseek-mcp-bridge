# Copy this file to .env and fill it in. Never commit .env.

# A DeepSeek API key. Create one at https://platform.deepseek.com
# Use a dedicated key for this bridge so it can be revoked independently.
DEEPSEEK_API_KEY=sk-your-key-here

# Optional overrides
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_TIMEOUT_MS=90000
# DEEPSEEK_MAX_OUTPUT_TOKENS=4096

# Secret path segment for the MCP endpoint. Generate with:
#   npm run ctl -- secret
# The full endpoint looks like https://<your-domain>/mcp/<this value>.
MCP_PATH_SECRET=replace-with-32-byte-random-hex

PORT=8787
# Listen address. Do NOT set this to 0.0.0.0 — the tunnel runs on the same
# machine, so there is no reason to expose the port to your LAN.
# HOST=127.0.0.1

# Requests per minute per IP.
RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# Agent jobs — read the Security model section of README.md before setting any
# of these. Leaving this block commented out keeps the bridge read-only.
# ---------------------------------------------------------------------------

# Roots a sub-agent may work in, separated by ';'. EMPTY MEANS DENY EVERYTHING.
# Setting this is the switch that hands over the machine: whoever holds the MCP
# URL can then make the sub-agent read, write and run commands in those roots.
# DEEPSEEK_ALLOWED_ROOTS=D:\work\agent-scratch

# Step ceiling per job.
# BRIDGE_MAX_STEPS=40

# Wall-clock ceiling per job, ms. On expiry the job and its whole process tree
# are killed.
# BRIDGE_JOB_TIMEOUT_MS=900000

# How long a command waits for a human, ms. Expiry is a deny.
# BRIDGE_APPROVAL_TIMEOUT_MS=300000

# Command NAMES that run without asking. Everything else pauses the job until
# you answer with `npm run ctl -- approve <id>` / `deny <id>`.
# BRIDGE_APPROVE_ALLOW=node,npm,npx,git,tsc,dir,ls,cat,type,find,grep,echo

# Set to "off" to skip the approval queue entirely — every command runs
# unattended. Only for `npm run accept`. Do not leave this off.
# BRIDGE_CC_APPROVAL=off

# Path to the Claude Code binary, if not on PATH.
# BRIDGE_CLAUDE_BIN=

# Where the harness sends its requests. Defaults to DEEPSEEK_BASE_URL + /anthropic.
# BRIDGE_ANTHROPIC_BASE_URL=

# Job snapshots, approval queue and audit log live here.
# BRIDGE_STATE_DIR=

# Opt-in --max-budget-usd for the harness. Off by default because Claude Code
# prices at Claude rates: a limit here reads as roughly 100x the real DeepSeek
# cost and would cut jobs off early.
# BRIDGE_CC_MAX_BUDGET_USD=
