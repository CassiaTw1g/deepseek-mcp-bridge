{
  "name": "deepseek-mcp-bridge",
  "version": "1.0.0",
  "description": "MCP server that exposes DeepSeek as a tool for ChatGPT connectors",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "deepseek",
    "chatgpt",
    "connector",
    "llm",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CassiaTw1g/deepseek-mcp-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/CassiaTw1g/deepseek-mcp-bridge/issues"
  },
  "homepage": "https://github.com/CassiaTw1g/deepseek-mcp-bridge#readme",
  "files": [
    "src",
    "scripts",
    "tsconfig.json",
    ".env.example",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "ctl": "node scripts/ctl.mjs",
    "start": "node scripts/ctl.mjs start",
    "stop": "node scripts/ctl.mjs stop",
    "restart": "node scripts/ctl.mjs restart",
    "status": "node scripts/ctl.mjs status",
    "logs": "node scripts/ctl.mjs logs",
    "enable": "node scripts/ctl.mjs enable",
    "disable": "node scripts/ctl.mjs disable",
    "tunnel": "node scripts/ctl.mjs tunnel",
    "untunnel": "node scripts/ctl.mjs untunnel",
    "uninstall": "node scripts/ctl.mjs uninstall",
    "dev": "node src/server.ts",
    "test": "npm run typecheck && npm run selftest:memory",
    "typecheck": "tsc --noEmit",
    "selftest": "node scripts/selftest.mjs",
    "selftest:memory": "node scripts/selftest-memory.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2"
  }
}
